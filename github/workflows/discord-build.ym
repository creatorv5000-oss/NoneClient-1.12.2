name: Discord Build Notification

on: [push, pull_request]

jobs:
  notify-build:
    runs-on: ubuntu-latest
    steps:
      # 1. Prepare environment
      - name: Checkout Code
        uses: actions/checkout@v4

      # 2. Sends the "Build Started" card to Discord
      - name: Alert Build Started
        run: |
          curl -H "Content-Type: application/json" \
               -X POST \
               -d '{
                 "embeds": [{
                   "title": "🛠️ Build Started",
                   "description": "**Service:** NoneClient Build\n**Triggered by:** ${{ github.actor }}",
                   "color": 8421504
                 }]
               }' \
               ${{ secrets.DISCORD_WEBHOOK }}

      # 3. Simulates compiling your project files
      - name: Running Code Build
        run: |
          echo "Compiling NoneClient project files..."
          sleep 5

      # 4. Sends the green "Build Succeeded" card to Discord
      - name: Alert Build Succeeded
        if: success()
        run: |
          curl -H "Content-Type: application/json" \
               -X POST \
               -d '{
                 "embeds": [{
                   "title": "✅ Build Succeeded",
                   "description": "**Service:** NoneClient Build\n**Status:** Successfully compiled and ready.",
                   "color": 3066993
                 }]
               }' \
               ${{ secrets.DISCORD_WEBHOOK }}

      # 5. Sends a red "Build Failed" card if anything goes wrong
      - name: Alert Build Failed
        if: failure()
        run: |
          curl -H "Content-Type: application/json" \
               -X POST \
               -d '{
                 "embeds": [{
                   "title": "❌ Build Failed",
                   "description": "**Service:** NoneClient Build\n**Status:** Error caught during compilation process.",
                   "color": 15158332
                 }]
               }' \
               ${{ secrets.DISCORD_WEBHOOK }}
